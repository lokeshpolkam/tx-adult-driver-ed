{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/mcqs/(.*)\\.json",
      "destination": "/404",
      "permanent": false
    },
    {
      "source": "/how-it-works",
      "destination": "/#how-it-works",
      "permanent": false
    },
    {
      "source": "/curriculum",
      "destination": "/#curriculum",
      "permanent": false
    },
    {
      "source": "/pricing",
      "destination": "/#pricing",
      "permanent": false
    },
    {
      "source": "/faq",
      "destination": "/#faq",
      "permanent": false
    },
    {
      "source": "/texas-adult-driver-ed",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/texas-dps-guide",
      "destination": "/regulatory",
      "permanent": false
    },
    {
      "source": "/first-license-checklist",
      "destination": "/about",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://tx-ade-api-1004296326114.us-central1.run.app/api/$1"
    },
    {
      "source": "/app_lessons/assets/(.*)",
      "destination": "/final_course_export/assets/$1"
    },
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/landing",
      "destination": "/landing.html"
    },
    {
      "source": "/enroll",
      "destination": "/checkout.html"
    },
    {
      "source": "/signup",
      "destination": "/signup.html"
    },
    {
      "source": "/signin",
      "destination": "/signin.html"
    },
    {
      "source": "/login",
      "destination": "/signin.html"
    },
    {
      "source": "/checkout",
      "destination": "/checkout.html"
    },
    {
      "source": "/payments",
      "destination": "/checkout.html"
    },
    {
      "source": "/home",
      "destination": "/home.html"
    },
    {
      "source": "/dashboard",
      "destination": "/home.html"
    },
    {
      "source": "/classroom",
      "destination": "/player.html"
    },
    {
      "source": "/player",
      "destination": "/player.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/verify",
      "destination": "/verify.html"
    },
    {
      "source": "/certificate",
      "destination": "/verify.html"
    },
    {
      "source": "/reviews",
      "destination": "/reviews.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/refund-policy",
      "destination": "/refund-policy.html"
    },
    {
      "source": "/regulatory",
      "destination": "/regulatory.html"
    },
    {
      "source": "/404",
      "destination": "/404.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|svg|webp|ico|woff2|woff|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(final_course_export|app_lessons)/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/final_course_export/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/mcqs/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/accept-invite(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/partner(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ]
}