{
  "version": 2,
  "rewrites": [
    { "source": "/classroom", "destination": "/player.html" },
    { "source": "/player", "destination": "/player.html" },
    { "source": "/landing", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
