{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/course_shell/index.html" },
    { "source": "/index.html", "destination": "/course_shell/index.html" },
    { "source": "/classroom", "destination": "/course_shell/player.html" },
    { "source": "/player", "destination": "/course_shell/player.html" },
    { "source": "/player.html", "destination": "/course_shell/player.html" },
    { "source": "/cloud_sync.js", "destination": "/course_shell/cloud_sync.js" },
    { "source": "/final_course_export/(.*)", "destination": "/course_shell/final_course_export/$1" },
    { "source": "/mcqs/(.*)", "destination": "/course_shell/mcqs/$1" },
    { "source": "/(.*)", "destination": "/course_shell/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
